---
import { m } from "../paraglide/messages.js";
import NavigationLinks from "./NavigationLinks.astro";
---
<header class="border-y border-border bg-surface px-5 sm:px-8 2xl:px-16">
  <nav aria-label={m.navigation()} class="flex min-h-20 items-center gap-8 2xl:min-h-22 2xl:gap-16">
    <a href="/" class="shrink-0 text-3xl font-bold tracking-tight">selfmail</a>
    <div class="hidden items-center gap-6 whitespace-nowrap text-lg 2xl:flex 2xl:gap-8">
      <NavigationLinks />
    </div>
    <div class="ml-auto hidden items-center gap-3 whitespace-nowrap text-lg 2xl:flex">
      <a href="https://auth.selfmail.app/login" class="nav-link mr-4">{m.login()}</a>
      <a href="mailto:sales@selfmail.app" class="button-secondary">{m.sales()}</a>
      <a href="https://auth.selfmail.app/register" class="button-primary">{m.start()}</a>
    </div>
    <details id="mobile-navigation" class="group ml-auto 2xl:hidden">
      <summary class="flex min-h-11 items-center gap-3 rounded-md px-2 text-base">
        {m.menu()}
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-5"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <div class="absolute inset-x-0 top-20 z-30 grid max-h-[calc(100dvh-5rem)] gap-3 overflow-y-auto border-b border-border bg-surface px-6 pt-5 pb-[max(2rem,env(safe-area-inset-bottom))] text-lg shadow-sm">
        <NavigationLinks />
        <a href="https://auth.selfmail.app/login" class="nav-link">{m.login()}</a>
        <div class="flex flex-wrap gap-3 pt-3">
          <a href="mailto:sales@selfmail.app" class="button-secondary">{m.sales()}</a>
          <a href="https://auth.selfmail.app/register" class="button-primary">{m.start()}</a>
        </div>
      </div>
    </details>
  </nav>
</header>
<script>
  import "../scripts/navigation";
</script>
