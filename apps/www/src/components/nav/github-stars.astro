---
import { getGitHubStars } from "../../lib/github-stars";

const stars = await getGitHubStars();
const formattedStars =
  stars === null
    ? null
    : new Intl.NumberFormat("en", {
        notation: "compact",
        maximumFractionDigits: 1,
      }).format(stars);
const label =
  stars === null
    ? "Selfmail on GitHub"
    : `Selfmail on GitHub (${stars.toLocaleString("en")} stars)`;
---

<a
  href="https://github.com/selfmail/selfmail"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={label}
  title={label}
  class="inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-md font-medium tabular-nums tracking-tight hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2"
>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-5">
    <path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.104.769-.244.769-.542 0-.267-.01-.975-.015-1.914-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.022-.699.078-.685.078-.685 1.13.08 1.725 1.16 1.725 1.16 1.005 1.722 2.636 1.225 3.278.937.102-.728.393-1.225.715-1.507-2.498-.284-5.124-1.249-5.124-5.562 0-1.229.44-2.232 1.16-3.02-.116-.285-.503-1.429.11-2.978 0 0 .945-.303 3.094 1.154A10.79 10.79 0 0 1 12 6.184c.956.004 1.918.129 2.817.378 2.148-1.457 3.091-1.154 3.091-1.154.615 1.549.228 2.693.112 2.977.722.789 1.159 1.792 1.159 3.021 0 4.324-2.63 5.275-5.136 5.554.404.35.766 1.043.766 2.101 0 1.517-.014 2.741-.014 3.113 0 .3.203.65.774.54A11.252 11.252 0 0 0 12 .75Z" />
  </svg>
  {formattedStars !== null && <span>{formattedStars}</span>}
</a>
