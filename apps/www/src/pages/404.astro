---
import Header from "../components/nav/Header.astro";
import Layout from "../layouts/Layout.astro";
import { getLocale } from "../paraglide/runtime.js";

const copy = {
  en: {
    heading: "This page went missing.",
    description: "Even we can't find it in the inbox.",
    home: "Back to home",
    check: "Check spam?",
    joke: "Nope. Just a prince offering us a very exciting investment opportunity.",
  },
  de: {
    heading: "Diese Seite ist verschwunden.",
    description: "Auch wir finden sie nicht im Posteingang.",
    home: "Zur Startseite",
    check: "Im Spam nachsehen?",
    joke: "Nichts. Nur ein Prinz mit einer äußerst spannenden Investitionsmöglichkeit.",
  },
  fr: {
    heading: "Cette page a disparu.",
    description: "Même nous ne la trouvons pas dans la boîte de réception.",
    home: "Retour à l’accueil",
    check: "Vérifier les spams ?",
    joke: "Non. Juste un prince qui nous propose un investissement très prometteur.",
  },
  es: {
    heading: "Esta página ha desaparecido.",
    description: "Ni nosotros la encontramos en la bandeja de entrada.",
    home: "Volver al inicio",
    check: "¿Mirar en spam?",
    joke: "Nada. Solo un príncipe con una oportunidad de inversión muy emocionante.",
  },
}[getLocale()];
---
<Layout>
  <Header />
  <main id="main" tabindex="-1" class="flex min-h-[calc(100dvh-5rem-2px)] items-center justify-center bg-surface px-5 py-16 sm:px-8 2xl:min-h-[calc(100dvh-5.5rem-2px)]">
    <div class="w-full max-w-md text-center">
      <p class="font-mono text-8xl leading-none tracking-tighter text-muted sm:text-9xl">404</p>
      <h1 class="mt-8 text-2xl font-medium tracking-tight sm:text-3xl">{copy.heading}</h1>
      <p class="mt-3 text-pretty text-muted">{copy.description}</p>
      <a href="/" class="button-primary mt-8">{copy.home}</a>
      <details class="mx-auto mt-8 max-w-xs text-sm text-muted">
        <summary class="mx-auto w-fit rounded-sm px-2 py-2 underline decoration-border underline-offset-4 hover:text-foreground">{copy.check}</summary>
        <p class="mt-3 text-pretty leading-relaxed">{copy.joke}</p>
      </details>
    </div>
  </main>
</Layout>
