---
import { ClientRouter, fade } from "astro:transitions";
import { m } from "../lib/messages";
import { getLocale } from "../paraglide/runtime.js";
import "../styles/global.css";
---
<!doctype html>
<html lang={getLocale()} transition:animate={fade({ duration: "180ms" })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={m.description()} />
    <title>Selfmail</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        let mode = "auto";
        try {
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") mode = stored;
        } catch { /* System preference remains available without storage. */ }
        document.documentElement.dataset.theme = mode;
        document.documentElement.classList.toggle("dark", mode === "dark" || (mode === "auto" && matchMedia("(prefers-color-scheme: dark)").matches));
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background font-sans text-foreground antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-24 focus:left-6 focus:z-50 focus:rounded-md focus:bg-foreground focus:p-3 focus:text-background">{m.skip()}</a>
    <slot />
    <script>
      const key = import.meta.env.PUBLIC_POSTHOG_KEY;
      if (import.meta.env.PROD && key) {
        const { default: posthog } = await import("posthog-js");
        posthog.init(key, {
          api_host: import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com",
          defaults: "2025-11-30",
          capture_pageview: "history_change",
          capture_pageleave: true,
          disable_external_dependency_loading: true,
          person_profiles: "identified_only",
        });
      }
    </script>
  </body>
</html>
